{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "outDir": "dist",
    "rootDir": ".",
    "allowSyntheticDefaultImports": true
  },
  "include": ["*.ts", "routes/**/*", "models/**/*", "utils/**/*", "config/**/*", "services/**/*"],
  "exclude": ["node_modules", "client"]
}
