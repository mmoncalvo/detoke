# Copiá este archivo a .env y ajustá los valores.

# Puerto donde corre todo (API + web)
PORT=3000

# Base de datos
# Sin DATABASE_URL: SQLite en ./database.sqlite (se crea sola).
# Otra ruta para la SQLite:
# DATABASE_PATH=./database.sqlite
# Postgres:
# DATABASE_URL=postgres://detoke:detoke@localhost:5432/detoke

# Clave para firmar las sesiones. En producción es obligatoria y larga.
JWT_SECRET=cambiar-por-una-clave-larga

# Orígenes que pueden llamar a la API en producción además de la web
CORS_ORIGINS=http://localhost,https://localhost
