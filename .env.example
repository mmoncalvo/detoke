# Copy this file to .env and adjust the values.

# Port for everything (API + web)
PORT=3000

# Database
# Without DATABASE_URL: SQLite at ./database.sqlite (created on demand).
# Another path for the SQLite file:
# DATABASE_PATH=./database.sqlite
# Postgres:
# DATABASE_URL=postgres://detoke:detoke@localhost:5432/detoke

# Key used to sign sessions. Required and long in production.
JWT_SECRET=change-to-a-long-secret

# Origins allowed to call the API in production, besides the web app
CORS_ORIGINS=http://localhost,https://localhost
