# Copy this file to .env and adjust the values.

# Port for everything (API + web)
PORT=3000

# Database
# Without DATABASE_URL: SQLite at ./database.sqlite (created on demand).
# Another path for the SQLite file:
# DATABASE_PATH=./database.sqlite
# Postgres (required in production):
# DATABASE_URL=postgres://detoke:detoke@localhost:5432/detoke
# External connection strings (for example Render's from outside Render) need TLS:
# DATABASE_SSL=true

# Uploaded images. On Render, point it to a Persistent Disk or uploads are lost on each deploy.
# UPLOADS_DIR=./data/uploads

# Key used to sign sessions. Required and long in production.
JWT_SECRET=change-to-a-long-secret

# Public address of the web app (OAuth flows come back here)
APP_URL=http://localhost:3000

# Google sign-in. Without both values the "Continuar con Google" button is hidden.
# Create an OAuth client of type "Web application" in Google Cloud Console (see README).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Defaults to $APP_URL/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Public contact details and destination of the contact form
CONTACT_EMAIL=hola@detoke.test
# CONTACT_WHATSAPP=5491123456789
# CONTACT_HOURS=Lunes a viernes de 9 a 18

# Email. Without SMTP_HOST, contact messages are only stored in the database.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=Detoke <hola@detoke.test>

# Origins allowed to call the API in production (defaults to APP_URL)
# CORS_ORIGINS=https://detoke.onrender.com
