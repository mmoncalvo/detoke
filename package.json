{
  "name": "detoke",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon server.ts",
    "client:dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "seed": "tsx setup.ts",
    "migrate": "sequelize-cli db:migrate",
    "seeders": "sequelize-cli db:seed:all"
  },
  "dependencies": {
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "sequelize": "^6.37.8",
    "sqlite3": "^6.0.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.4",
    "tsx": "^4.21.0",
    "sequelize-cli": "^6.6.3"
  }
}
